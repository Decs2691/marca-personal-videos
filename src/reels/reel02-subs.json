{
 "lines": [
  {
   "text": "Tu perfil de Instagram",
   "start": 0.0,
   "end": 0.89
  },
  {
   "text": "te está perdiendo clientes,",
   "start": 0.89,
   "end": 2.56
  },
  {
   "text": "y no es por",
   "start": 2.56,
   "end": 3.62
  },
  {
   "text": "lo que crees.",
   "start": 3.62,
   "end": 4.02
  },
  {
   "text": "No es el contenido,",
   "start": 4.02,
   "end": 5.62
  },
  {
   "text": "no es la estética.",
   "start": 5.62,
   "end": 6.97
  },
  {
   "text": "Son 3 cosas puntuales",
   "start": 6.97,
   "end": 7.88
  },
  {
   "text": "que casi nadie revisa…",
   "start": 7.88,
   "end": 9.28
  },
  {
   "text": "y un bonus al final",
   "start": 9.28,
   "end": 10.52
  },
  {
   "text": "que casi nadie aprovecha.",
   "start": 10.52,
   "end": 12.11
  },
  {
   "text": "Primero:",
   "start": 12.11,
   "end": 12.72
  },
  {
   "text": "tu nombre de usuario.",
   "start": 12.72,
   "end": 13.59
  },
  {
   "text": "Tiene que ser claro,",
   "start": 13.59,
   "end": 14.34
  },
  {
   "text": "no un código random.",
   "start": 14.34,
   "end": 15.77
  },
  {
   "text": "Segundo:",
   "start": 15.77,
   "end": 16.14
  },
  {
   "text": "tu foto de perfil.",
   "start": 16.14,
   "end": 17.25
  },
  {
   "text": "Que se vea tu cara",
   "start": 17.25,
   "end": 17.99
  },
  {
   "text": "o tu marca clara,",
   "start": 17.99,
   "end": 18.73
  },
  {
   "text": "no un logo genérico",
   "start": 18.73,
   "end": 20.37
  },
  {
   "text": "sin contexto.",
   "start": 20.37,
   "end": 21.24
  },
  {
   "text": "Tercero, el que más",
   "start": 21.24,
   "end": 22.23
  },
  {
   "text": "se salta: la bio.",
   "start": 22.23,
   "end": 23.02
  },
  {
   "text": "Tiene que responder",
   "start": 23.02,
   "end": 23.66
  },
  {
   "text": "3 preguntas,",
   "start": 23.66,
   "end": 24.97
  },
  {
   "text": "en una línea cada una:",
   "start": 24.97,
   "end": 26.87
  },
  {
   "text": "qué haces,",
   "start": 26.87,
   "end": 27.24
  },
  {
   "text": "qué resultados tienes,",
   "start": 27.24,
   "end": 28.44
  },
  {
   "text": "y qué hago ahora.",
   "start": 28.44,
   "end": 29.88
  },
  {
   "text": "Y el bonus:",
   "start": 29.88,
   "end": 30.4
  },
  {
   "text": "tus destacadas.",
   "start": 30.4,
   "end": 31.05
  },
  {
   "text": "Pon quién soy,",
   "start": 31.05,
   "end": 31.44
  },
  {
   "text": "qué hago y testimonios.",
   "start": 31.44,
   "end": 32.7
  },
  {
   "text": "Pero lo más importante:",
   "start": 32.7,
   "end": 33.94
  },
  {
   "text": "que quede clarísimo",
   "start": 33.94,
   "end": 35.07
  },
  {
   "text": "cómo contactarte.",
   "start": 35.07,
   "end": 35.84
  },
  {
   "text": "Yo lo hago por DM,",
   "start": 35.84,
   "end": 36.62
  },
  {
   "text": "tú usa WhatsApp",
   "start": 36.62,
   "end": 37.27
  },
  {
   "text": "o tu web,",
   "start": 37.27,
   "end": 37.85
  },
  {
   "text": "pero que nadie tenga",
   "start": 37.85,
   "end": 38.76
  },
  {
   "text": "que adivinarlo.",
   "start": 38.76,
   "end": 40.15
  },
  {
   "text": "Cuando esto está claro,",
   "start": 40.15,
   "end": 41.44
  },
  {
   "text": "cualquiera que llega",
   "start": 41.44,
   "end": 42.12
  },
  {
   "text": "a tu perfil",
   "start": 42.12,
   "end": 42.83
  },
  {
   "text": "entiende en segundos",
   "start": 42.83,
   "end": 43.79
  },
  {
   "text": "si le sirves",
   "start": 43.79,
   "end": 44.34
  },
  {
   "text": "y qué hacer después.",
   "start": 44.34,
   "end": 45.16
  },
  {
   "text": "No te digo",
   "start": 45.16,
   "end": 46.01
  },
  {
   "text": "qué está mal.",
   "start": 46.01,
   "end": 46.48
  },
  {
   "text": "Te digo qué cambiar.",
   "start": 46.48,
   "end": 48.36
  },
  {
   "text": "Sígueme si quieres",
   "start": 48.36,
   "end": 49.71
  },
  {
   "text": "dejar de perder clientes.",
   "start": 49.71,
   "end": 50.92
  }
 ],
