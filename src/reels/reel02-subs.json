{
 "lines": [
  {
   "text": "Tu perfil de Instagram",
   "start": 0.0,
   "end": 1.06
  },
  {
   "text": "está perdiendo clientes",
   "start": 1.06,
   "end": 2.28
  },
  {
   "text": "y no es por",
   "start": 2.28,
   "end": 2.72
  },
  {
   "text": "lo que crees.",
   "start": 2.72,
   "end": 3.48
  },
  {
   "text": "No es el contenido,",
   "start": 3.48,
   "end": 5.03
  },
  {
   "text": "no es la estética.",
   "start": 5.03,
   "end": 6.31
  },
  {
   "text": "Son 3 cosas puntuales",
   "start": 6.31,
   "end": 7.4
  },
  {
   "text": "que casi nadie revisa.",
   "start": 7.4,
   "end": 8.63
  },
  {
   "text": "Y al final",
   "start": 8.63,
   "end": 9.14
  },
  {
   "text": "te voy a dar",
   "start": 9.14,
   "end": 9.5
  },
  {
   "text": "un bonus que casi",
   "start": 9.5,
   "end": 10.54
  },
  {
   "text": "nadie aprovecha.",
   "start": 10.54,
   "end": 11.32
  },
  {
   "text": "Primero,",
   "start": 11.32,
   "end": 11.88
  },
  {
   "text": "tu nombre de usuario.",
   "start": 11.88,
   "end": 12.72
  },
  {
   "text": "Tiene que ser claro,",
   "start": 12.72,
   "end": 13.68
  },
  {
   "text": "no un código random.",
   "start": 13.68,
   "end": 14.86
  },
  {
   "text": "Segundo,",
   "start": 14.86,
   "end": 15.53
  },
  {
   "text": "tu foto de perfil",
   "start": 15.53,
   "end": 16.63
  },
  {
   "text": "tiene que ser clara",
   "start": 16.63,
   "end": 17.66
  },
  {
   "text": "o tu logo,",
   "start": 17.66,
   "end": 18.34
  },
  {
   "text": "si es una empresa,",
   "start": 18.34,
   "end": 19.36
  },
  {
   "text": "tiene que ser claro.",
   "start": 19.36,
   "end": 20.37
  },
  {
   "text": "Mi recomendación:",
   "start": 20.37,
   "end": 21.24
  },
  {
   "text": "que sea tu cara.",
   "start": 21.24,
   "end": 21.98
  },
  {
   "text": "Tercero, y este es",
   "start": 21.98,
   "end": 22.6
  },
  {
   "text": "el que más se salta:",
   "start": 22.6,
   "end": 24.32
  },
  {
   "text": "La bio tiene que",
   "start": 24.32,
   "end": 25.42
  },
  {
   "text": "responder 3 preguntas",
   "start": 25.42,
   "end": 26.87
  },
  {
   "text": "en una línea cada una.",
   "start": 26.87,
   "end": 28.22
  },
  {
   "text": "¿Qué haces?",
   "start": 28.22,
   "end": 28.81
  },
  {
   "text": "¿Qué resultados tienes?",
   "start": 28.81,
   "end": 29.88
  },
  {
   "text": "¿Y qué hacer ahora?",
   "start": 29.88,
   "end": 30.74
  },
  {
   "text": "Pon lo que sea,",
   "start": 30.74,
   "end": 31.48
  },
  {
   "text": "pero que tengan",
   "start": 31.48,
   "end": 32.08
  },
  {
   "text": "cómo contratarte.",
   "start": 32.08,
   "end": 32.7
  },
  {
   "text": "Nadie tiene que adivinarlo.",
   "start": 32.7,
   "end": 33.94
  },
  {
   "text": "Yo lo hago por DM.",
   "start": 33.94,
   "end": 35.07
  },
  {
   "text": "Tú lo puedes hacer",
   "start": 35.07,
   "end": 35.7
  },
  {
   "text": "por tu WhatsApp,",
   "start": 35.7,
   "end": 36.44
  },
  {
   "text": "por tu página web",
   "start": 36.44,
   "end": 37.32
  },
  {
   "text": "y el bonus son",
   "start": 37.32,
   "end": 37.85
  },
  {
   "text": "tus historias destacadas.",
   "start": 37.85,
   "end": 39.21
  },
  {
   "text": "Pon quién soy,",
   "start": 39.21,
   "end": 40.15
  },
  {
   "text": "qué hago,",
   "start": 40.15,
   "end": 40.98
  },
  {
   "text": "testimonios.",
   "start": 40.98,
   "end": 41.76
  },
  {
   "text": "Cuando está claro,",
   "start": 41.76,
   "end": 42.55
  },
  {
   "text": "cualquiera que llegue",
   "start": 42.55,
   "end": 43.08
  },
  {
   "text": "a tu perfil",
   "start": 43.08,
   "end": 43.64
  },
  {
   "text": "va a entender",
   "start": 43.64,
   "end": 44.16
  },
  {
   "text": "si le sirves",
   "start": 44.16,
   "end": 44.8
  },
  {
   "text": "o qué tiene que",
   "start": 44.8,
   "end": 45.38
  },
  {
   "text": "hacer después.",
   "start": 45.38,
   "end": 46.01
  },
  {
   "text": "No te digo",
   "start": 46.01,
   "end": 46.56
  },
  {
   "text": "qué está mal,",
   "start": 46.56,
   "end": 47.62
  },
  {
   "text": "te digo cómo mejorar.",
   "start": 47.62,
   "end": 49.11
  },
  {
   "text": "Y sígueme si quieres",
   "start": 49.11,
   "end": 50.14
  },
  {
