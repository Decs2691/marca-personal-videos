{
 "lines": [
  {
   "text": "Analicé el Instagram",
   "start": 0.0,
   "end": 0.98
  },
  {
   "text": "de Mr. Burger,",
   "start": 0.98,
   "end": 1.72
  },
  {
   "text": "un restaurante colombiano",
   "start": 1.72,
   "end": 2.62
  },
  {
   "text": "que tiene un poco",
   "start": 2.62,
   "end": 3.32
  },
  {
   "text": "más de 7.000 seguidores,",
   "start": 3.32,
   "end": 4.8
  },
  {
   "text": "pero encontré algo",
   "start": 4.8,
   "end": 5.44
  },
  {
   "text": "que de pronto podría",
   "start": 5.44,
   "end": 6.2
  },
  {
   "text": "hacer que sus ventas",
   "start": 6.2,
   "end": 6.94
  },
  {
   "text": "aumenten.",
   "start": 6.94,
   "end": 7.24
  },
  {
   "text": "Pero quiero mencionar",
   "start": 7.24,
   "end": 8.04
  },
  {
   "text": "que están haciendo cosas",
   "start": 8.04,
   "end": 8.8
  },
  {
   "text": "que están realmente bien.",
   "start": 8.8,
   "end": 10.14
  },
  {
   "text": "Primero, una foto",
   "start": 10.14,
   "end": 10.88
  },
  {
   "text": "de perfil clara.",
   "start": 10.88,
   "end": 11.61
  },
  {
   "text": "Segundo,",
   "start": 11.61,
   "end": 12.26
  },
  {
   "text": "tienen una bio que",
   "start": 12.26,
   "end": 13.08
  },
  {
   "text": "tiene la información completa",
   "start": 13.08,
   "end": 14.23
  },
  {
   "text": "y una identidad visual",
   "start": 14.23,
   "end": 15.16
  },
  {
   "text": "que es consistente.",
   "start": 15.16,
   "end": 16.08
  },
  {
   "text": "Su grid tiene",
   "start": 16.08,
   "end": 16.96
  },
  {
   "text": "mucha alineación",
   "start": 16.96,
   "end": 17.6
  },
  {
   "text": "y mucha coherencia",
   "start": 17.6,
   "end": 18.34
  },
  {
   "text": "y no es que",
   "start": 18.34,
   "end": 18.78
  },
  {
   "text": "se vea solamente",
   "start": 18.78,
   "end": 19.6
  },
  {
   "text": "bien en pantalla.",
   "start": 19.6,
   "end": 20.28
  },
  {
   "text": "Yo fui personalmente",
   "start": 20.28,
   "end": 21.32
  },
  {
   "text": "y la verdad",
   "start": 21.32,
   "end": 21.72
  },
  {
   "text": "es que la comida",
   "start": 21.72,
   "end": 22.22
  },
  {
   "text": "es deliciosa.",
   "start": 22.22,
   "end": 22.91
  },
  {
   "text": "Sin embargo,",
   "start": 22.91,
   "end": 23.52
  },
  {
   "text": "hay tres cosas",
   "start": 23.52,
   "end": 24.14
  },
  {
   "text": "que los pueden llevar",
   "start": 24.14,
   "end": 24.84
  },
  {
   "text": "al siguiente nivel.",
   "start": 24.84,
   "end": 25.44
  },
  {
   "text": "Primero,",
   "start": 25.44,
   "end": 25.88
  },
  {
   "text": "hoy publican",
   "start": 25.88,
   "end": 26.46
  },
  {
   "text": "una vez por semana,",
   "start": 26.46,
   "end": 27.24
  },
  {
   "text": "y eso está bien,",
   "start": 27.24,
   "end": 27.81
  },
  {
   "text": "pero subir",
   "start": 27.81,
   "end": 28.36
  },
  {
   "text": "dos o tres publicaciones",
   "start": 28.36,
   "end": 29.38
  },
  {
   "text": "por semana",
   "start": 29.38,
   "end": 29.87
  },
  {
   "text": "les daría un poco",
   "start": 29.87,
   "end": 30.62
  },
  {
   "text": "más de alcance.",
   "start": 30.62,
   "end": 31.15
  },
  {
   "text": "Segundo,",
   "start": 31.15,
   "end": 31.76
  },
  {
   "text": "historias destacadas",
   "start": 31.76,
   "end": 32.68
  },
  {
   "text": "con el menú,",
   "start": 32.68,
   "end": 33.29
  },
  {
   "text": "lo que dicen",
   "start": 33.29,
   "end": 33.84
  },
  {
   "text": "sus clientes",
   "start": 33.84,
   "end": 34.4
  },
  {
   "text": "y cómo pedir",
   "start": 34.4,
   "end": 35.06
  },
  {
   "text": "para que esa información",
   "start": 35.06,
   "end": 35.82
  },
  {
   "text": "que no desaparezca",
   "start": 35.82,
   "end": 36.48
  },
  {
   "text": "en 24 horas.",
   "start": 36.48,
   "end": 37.25
  },
  {
   "text": "Y tercero,",
   "start": 37.25,
   "end": 37.92
  },
  {
   "text": "ya hacen historias",
   "start": 37.92,
   "end": 38.6
  },
  {
   "text": "todos los días,",
   "start": 38.6,
   "end": 39.25
  },
  {
   "text": "así que aprovéchenlas",
   "start": 39.25,
   "end": 40.12
  },
  {
   "text": "con preguntas y encuestas",
   "start": 40.12,
   "end": 41.02
  },
  {
   "text": "que pongan",
   "start": 41.02,
   "end": 41.34
  },
  {
   "text": "a sus clientes",
   "start": 41.34,
   "end": 42.0
  },
  {
   "text": "a hablar con ustedes.",
   "start": 42.0,
   "end": 42.86
  },
  {
   "text": "Así que recuerden,",
   "start": 42.86,
   "end": 43.5
  },
  {
   "text": "no les digo",
   "start": 43.5,
   "end": 43.94
  },
  {
   "text": "qué está mal,",
   "start": 43.94,
   "end": 44.4
  },
  {
   "text": "tal vez solamente",
   "start": 44.4,
   "end": 44.94
  },
  {
   "text": "les digo qué mejorar.",
   "start": 44.94,
   "end": 45.72
  },
  {
   "text": "¿Tú qué le",
   "start": 45.72,
   "end": 46.24
  },
  {
   "text": "preguntarías a tu",
   "start": 46.24,
   "end": 46.84
  },
  {
   "text": "restaurante favorito?",
   "start": 46.84,
   "end": 47.57
  },
  {
   "text": "Respóndeme en los comentarios.",
   "start": 47.57,
   "end": 48.95
  }
