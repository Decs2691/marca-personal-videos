 "lines": [
  {
   "text": "Analicé el Instagram",
   "start": 0.0,
   "end": 0.98
  },
  {
   "text": "de Mr. Burger,",
   "start": 0.98,
   "end": 1.72
  },
  {
   "text": "un restaurante colombiano",
   "start": 1.72,
   "end": 2.62
  },
  {
   "text": "que tiene un poco",
   "start": 2.62,
   "end": 3.32
  },
  {
   "text": "más de 7.000 seguidores,",
   "start": 3.32,
   "end": 4.8
  },
  {
   "text": "pero encontré algo",
   "start": 4.8,
   "end": 5.44
  },
  {
   "text": "que de pronto podría",
   "start": 5.44,
   "end": 6.2
  },
  {
   "text": "hacer que sus ventas",
   "start": 6.2,
   "end": 6.92
  },
  {
   "text": "aumenten.",
   "start": 6.92,
   "end": 7.22
  },
  {
   "text": "Pero quiero mencionar",
   "start": 7.22,
   "end": 8.04
  },
  {
   "text": "que están haciendo cosas",
   "start": 8.04,
   "end": 8.8
  },
  {
   "text": "que están realmente bien.",
   "start": 8.8,
   "end": 10.14
  },
  {
   "text": "Primero, una foto",
   "start": 10.14,
   "end": 10.88
  },
  {
   "text": "de perfil clara.",
   "start": 10.88,
   "end": 11.61
  },
  {
   "text": "Segundo,",
   "start": 11.61,
   "end": 12.26
  },
  {
   "text": "tienen una bio que",
   "start": 12.26,
   "end": 13.08
  },
  {
   "text": "tiene la información completa",
   "start": 13.08,
   "end": 14.23
  },
  {
   "text": "y una identidad visual",
   "start": 14.23,
   "end": 15.16
  },
  {
   "text": "que es consistente.",
   "start": 15.16,
   "end": 16.08
  },
  {
   "text": "Su grid tiene",
   "start": 16.08,
   "end": 16.96
  },
  {
   "text": "mucha alineación",
   "start": 16.96,
   "end": 17.58
  },
  {
   "text": "y mucha coherencia",
   "start": 17.58,
   "end": 18.34
  },
  {
   "text": "y no es que",
   "start": 18.34,
   "end": 18.78
  },
  {
   "text": "se vea solamente",
   "start": 18.78,
   "end": 19.62
  },
  {
   "text": "bien en pantalla.",
   "start": 19.62,
   "end": 20.28
  },
  {
   "text": "Yo fui personalmente",
   "start": 20.28,
   "end": 21.32
  },
  {
   "text": "y la verdad",
   "start": 21.32,
   "end": 21.72
  },
  {
   "text": "es que la comida",
   "start": 21.72,
   "end": 22.22
  },
  {
   "text": "es deliciosa.",
   "start": 22.22,
   "end": 22.92
  },
  {
   "text": "Sin embargo,",
   "start": 22.92,
   "end": 23.31
  },
  {
   "text": "hay dos frentes",
   "start": 23.31,
   "end": 23.94
  },
  {
   "text": "que tal vez",
   "start": 23.94,
   "end": 24.34
  },
  {
   "text": "les están haciendo",
   "start": 24.34,
   "end": 25.24
  },
  {
   "text": "perder un poco",
   "start": 25.24,
   "end": 25.82
  },
  {
   "text": "de ventas.",
   "start": 25.82,
   "end": 26.3
  },
  {
   "text": "El primero es que",
   "start": 26.3,
   "end": 27.08
  },
  {
   "text": "un día postean,",
   "start": 27.08,
   "end": 27.9
  },
  {
   "text": "el otro no,",
   "start": 27.9,
   "end": 28.5
  },
  {
   "text": "una semana sí,",
   "start": 28.5,
   "end": 29.09
  },
  {
   "text": "una semana no,",
   "start": 29.09,
   "end": 29.9
  },
  {
   "text": "o sea,",
   "start": 29.9,
   "end": 30.26
  },
  {
   "text": "no hay consistencia.",
   "start": 30.26,
   "end": 31.04
  },
  {
   "text": "Y dos, el link",
   "start": 31.04,
   "end": 31.93
  },
  {
   "text": "con el que redirigen",
   "start": 31.93,
   "end": 32.78
  },
  {
   "text": "a las personas",
   "start": 32.78,
   "end": 33.28
  },
  {
   "text": "para hacer domicilio",
   "start": 33.28,
   "end": 33.94
  },
  {
   "text": "de forma directa",
   "start": 33.94,
   "end": 34.77
  },
  {
   "text": "tiene muchos",
   "start": 34.77,
   "end": 35.42
  },
  {
   "text": "espacios en blanco,",
   "start": 35.42,
   "end": 36.28
  },
  {
   "text": "tal vez sobresale más",
   "start": 36.28,
   "end": 37.36
  },
  {
   "text": "el precio",
   "start": 37.36,
   "end": 37.79
  },
  {
   "text": "que el plato,",
   "start": 37.79,
   "end": 38.31
  },
  {
   "text": "es decir el plato",
   "start": 38.31,
   "end": 39.48
  },
  {
   "text": "está perdiendo protagonismo.",
   "start": 39.48,
   "end": 40.59
  },
  {
   "text": "La solución es simple,",
   "start": 40.59,
   "end": 41.64
  },
  {
   "text": "postear dos o tres",
   "start": 41.64,
   "end": 42.22
  },
  {
   "text": "veces por semana",
   "start": 42.22,
   "end": 42.9
  },
  {
   "text": "van a empezar",
   "start": 42.9,
   "end": 43.4
  },
  {
   "text": "a solucionar las cosas,",
   "start": 43.4,
   "end": 44.34
  },
  {
   "text": "o por lo menos",
   "start": 44.34,
   "end": 44.99
  },
  {
   "text": "una vez por semana",
   "start": 44.99,
   "end": 46.38
  },
  {
   "text": "deberían estar posteando.",
   "start": 46.38,
   "end": 47.01
  },
  {
   "text": "Y sencillo,",
   "start": 47.01,
   "end": 47.76
  },
  {
   "text": "en la página web",
   "start": 47.76,
   "end": 48.64
  },
  {
   "text": "simplemente hagan que",
   "start": 48.64,
   "end": 49.3
  },
  {
   "text": "el plato sea",
   "start": 49.3,
   "end": 49.82
  },
  {
   "text": "el protagonista",
   "start": 49.82,
   "end": 50.3
  },
  {
   "text": "que usted solo",
   "start": 50.3,
   "end": 50.96
  },
  {
   "text": "con ver el plato,",
   "start": 50.96,
   "end": 51.78
  },
  {
   "text": "le dé hambre",
   "start": 51.78,
   "end": 52.32
  },
  {
   "text": "y le dé ganas",
   "start": 52.32,
   "end": 52.86
  },
  {
   "text": "de comer,",
   "start": 52.86,
   "end": 53.4
  },
  {
   "text": "eso me pasa",
   "start": 53.4,
   "end": 53.86
  },
  {
   "text": "a mí,",
   "start": 53.86,
   "end": 54.16
  },
  {
   "text": "pero como veo",
   "start": 54.16,
   "end": 54.68
  },
  {
   "text": "primero el precio,",
   "start": 54.68,
   "end": 55.42
  },
  {
   "text": "ya primero me aburro",
   "start": 55.42,
   "end": 56.5
  },
  {
   "text": "y luego ya no",
   "start": 56.5,
   "end": 56.89
  },
  {
   "text": "me da hambre,",
   "start": 56.89,
   "end": 57.45
  },
  {
   "text": "al igual no es",
   "start": 57.45,
   "end": 58.26
  },
  {
   "text": "nada costoso.",
   "start": 58.26,
   "end": 58.84
  },
  {
   "text": "Así que ya saben,",
   "start": 58.84,
   "end": 59.47
  },
  {
   "text": "plato grande,",
   "start": 59.47,
   "end": 60.22
  },
  {
   "text": "precio pequeño,",
   "start": 60.22,
   "end": 60.76
  },
  {
   "text": "así que recuerden,",
   "start": 60.76,
   "end": 61.42
  },
  {
   "text": "no les digo",
   "start": 61.42,
   "end": 61.86
  },
  {
   "text": "qué está mal,",
   "start": 61.86,
   "end": 62.32
  },
  {
   "text": "tal vez solamente",
   "start": 62.32,
   "end": 62.88
  },
  {
   "text": "les digo qué mejorar.",
   "start": 62.88,
   "end": 63.68
  },
  {
   "text": "¿Tú le has dado",
   "start": 63.68,
   "end": 64.24
  },
  {
   "text": "follow a una cuenta",
   "start": 64.24,
   "end": 65.0
  },
  {
   "text": "que un día",
   "start": 65.0,
   "end": 65.36
  },
  {
   "text": "te publica",
   "start": 65.36,
   "end": 65.74
  },
  {
   "text": "y luego demora semanas",
   "start": 65.74,
   "end": 67.18
  },
  {
   "text": "sin publicar absolutamente nada?",
   "start": 67.18,
   "end": 68.44
  },
  {
   "text": "Respóndeme en los comentarios",
   "start": 68.44,
   "end": 69.3
  },
  {
   "text": "y déjamelo saber.",
   "start": 69.3,
   "end": 69.87
  }
